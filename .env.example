# Copy to .env for local `netlify dev` use (never commit the real .env).
# See README-DEPLOY.md for the full setup walkthrough for each of these.

# --- Required: Supabase (README-DEPLOY.md steps 1-4) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: WhatsApp automation (README-DEPLOY.md "WhatsApp automation") ---
# Leave unset to run in demo/simulated sending mode.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_INVITE_TEMPLATE_NAME=wedding_invite
WHATSAPP_REMINDER_TEMPLATE_NAME=wedding_reminder
WHATSAPP_TEMPLATE_LANG=en_US

# --- Optional: SMS fallback via Africa's Talking ---
# Leave unset to run in demo/simulated sending mode.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Optional: templated into every invite/reminder as the voice-call fallback ---
PLANNER_FALLBACK_PHONE=+254 700 000 000
